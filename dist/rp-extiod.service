[Unit]
Description=RP external I2C/SPI/UART/GPIO bridge daemon
After=systemd-modules-load.service systemd-udevd.service

[Service]
Type=simple
ExecStartPre=/usr/local/bin/rp-extioctl prepare
ExecStart=/usr/local/bin/rp-extiod --config /etc/rp-extio/config.json --socket /run/rp-extiod.sock
Restart=on-failure
RestartSec=1
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ConfigurationDirectory=rp-extio
ReadWritePaths=/etc/rp-extio

[Install]
WantedBy=multi-user.target
