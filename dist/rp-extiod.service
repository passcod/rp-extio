[Unit]
Description=RP external I2C/SPI bridge daemon
After=systemd-modules-load.service

[Service]
Type=simple
ExecStartPre=modprobe rp_extio
ExecStart=/usr/local/bin/rp-extiod
Restart=on-failure
RestartSec=1
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
